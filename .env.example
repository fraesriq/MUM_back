NODE_ENV=development
PORT=3000

# Conexión MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Firma y validación de tokens de aplicaciones
AUTH_JWT_ISSUER=urn:mum:auth:local
AUTH_JWT_AUDIENCE=urn:mum:api
AUTH_JWT_ACTIVE_KID=local-dev
AUTH_JWT_KEY_RING=

# Cloudflare R2 privado
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_UPLOAD_TTL_SECONDS=300
R2_SIGNED_DOWNLOAD_TTL_SECONDS=3600
R2_MAX_FILE_SIZE_BYTES=10485760
